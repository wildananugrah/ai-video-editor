{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"lib": ["DOM", "ES2023"],
		"types": ["node"]
	},
	"include": ["src", "scripts", "remotion.config.ts"]
}
